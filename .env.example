# Copy this file to .env and fill in what you need. .env is gitignored.

# Optional: override where the pipeline writes parquet files (default: ./data)
# TENORA_DATA_DIR=

# Optional: FRED API key. NOT required today -- the pipeline uses the public
# fredgraph.csv endpoint. Reserved for a future move to the official FRED API:
# https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=
